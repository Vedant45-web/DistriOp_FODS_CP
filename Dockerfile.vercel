
# Build stage
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y \
    g++ \
    cmake \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY CMakeLists.txt .
COPY include ./include
COPY src ./src
COPY tests ./tests
COPY frontend ./frontend

RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
RUN cmake --build build --target distriopt_server -j2

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

COPY --from=build /app/build/distriopt_server ./distriopt_server
COPY --from=build /app/frontend ./frontend

ENV PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "./distriopt_server ${PORT:-8080}"]
